# ---------------------------------------------------------------------------
# Messaging platform feature flag
# ---------------------------------------------------------------------------
# telegram | whatsapp | both
MESSAGING_PLATFORM=telegram

# Telegram Bot Configuration (required when telegram is enabled)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (required when whatsapp is enabled)
# See docs/WHATSAPP_SETUP.md for how to obtain each of these from Meta.
# ---------------------------------------------------------------------------
# Meta -> Business Settings -> System Users -> permanent token
# (scopes: whatsapp_business_messaging, whatsapp_business_management)
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token
# Meta -> WhatsApp -> API Setup -> "Phone number ID" (NOT the phone number)
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Meta -> WhatsApp -> API Setup -> "WhatsApp Business Account ID"
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
# Any string you choose; paste the same value into Meta's webhook config screen
WHATSAPP_VERIFY_TOKEN=pick_a_long_random_string
# Meta -> App Settings -> Basic -> App Secret (verifies X-Hub-Signature-256)
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_API_VERSION=v21.0
WHATSAPP_REQUEST_TIMEOUT=30
# Approved template used to reach learners outside the 24h service window
WHATSAPP_TEMPLATE_DAILY_VIDEO=daily_video_ready
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Webhook server (serves the WhatsApp callback URL and /health)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WHATSAPP_WEBHOOK_PATH=/webhook/whatsapp

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/microlearning_db

# Agno Configuration
AGNO_API_KEY=your_agno_api_key_here
AGNO_ENV=development

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Agent Configuration
DAILY_VIDEO_TIME=09:00
VIDEO_BATCH_SIZE=1
QUESTION_TIMEOUT=300
# Upload a video to a platform on first request if not already published
AUTO_UPLOAD_MEDIA=true

# Paths / admin
VIDEOS_DIR=./data/videos
ADMIN_CHAT_ID=your_telegram_admin_chat_id
# Chat used to stage Telegram uploads and obtain a reusable file_id
TELEGRAM_UPLOAD_STAGING_CHAT_ID=your_telegram_admin_chat_id

# ---------------------------------------------------------------------------
# Voice input (local speech-to-text with faster-whisper)
# ---------------------------------------------------------------------------
# Learners can send a voice note instead of typing. Audio is transcribed on
# this machine and never sent to a third party. See docs/VOICE_INPUT.md.
VOICE_INPUT_ENABLED=true
# Echo the transcript back ("Heard: ...") before acting on it. Keep it on while
# tuning the model - it is the only way a learner can tell they were misheard.
VOICE_ECHO_TRANSCRIPT=true
# Recognise a spoken command in any language by translating it to English
# first. Only runs when the message would otherwise reach the menu.
VOICE_TRANSLATE_FOR_COMMANDS=true

# tiny | base | small | medium | large-v3 | large-v3-turbo | distil-large-v3
# "small" is the accuracy/speed knee on CPU; use large-v3-turbo on a GPU.
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
# auto | int8 | int8_float16 | float16 | float32  (auto = int8 on CPU)
WHISPER_COMPUTE_TYPE=auto
# Leave empty to detect the language of each clip; set "en" / "ta" / "hi" to pin it
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=1
WHISPER_VAD_FILTER=true
# 0 lets CTranslate2 choose; lower it to leave CPU headroom for the bot
WHISPER_CPU_THREADS=0
# Where model weights are cached (pre-seed this for an offline deployment)
WHISPER_MODEL_DIR=./data/models/whisper
# Load the model at startup so the first learner does not wait for the download
WHISPER_PRELOAD=true
# Guardrails on inbound audio
VOICE_MAX_SECONDS=300
VOICE_MAX_MB=16

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log
