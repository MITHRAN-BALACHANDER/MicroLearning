{% extends "base.html" %}
{% block title %}Users{% endblock %}

{% block extra_css %}
<style>
    .group-header {
        background: hsl(var(--secondary));
        border-top: 2px solid hsl(var(--primary));
        font-weight: 600;
    }
    
    .role-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 0.375rem;
        text-transform: capitalize;
    }
    
    .role-admin {
        background: hsl(var(--primary));
        color: hsl(var(--primary-foreground));
    }
    
    .role-instructor {
        background: hsl(var(--foreground));
        color: hsl(var(--background));
    }
    
    .role-learner {
        background: hsl(var(--secondary));
        color: hsl(var(--foreground));
        border: 1px solid hsl(var(--border));
    }
    
    .status-badge {
        display: inline-flex;
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        font-weight: 500;
        border-radius: 0.25rem;
    }
    
    .status-active {
        background: hsl(var(--primary));
        color: hsl(var(--primary-foreground));
    }
    
    .status-inactive {
        background: hsl(var(--muted));
        color: hsl(var(--muted-foreground));
    }
</style>
{% endblock %}

{% block content %}
<div class="mb-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-semibold tracking-tight" style="color: hsl(var(--foreground));">Users</h1>
            <p class="mt-2 text-sm" style="color: hsl(var(--muted-foreground));">Manage all platform users, grouped by role</p>
        </div>
        <button onclick="exportUsers()" class="px-4 py-2 text-sm font-medium rounded-lg transition-colors" style="background: hsl(var(--card)); color: hsl(var(--foreground)); border: 1px solid hsl(var(--border));">
            Export CSV
        </button>
    </div>
</div>

<div class="rounded-lg overflow-hidden" style="background: hsl(var(--card)); border: 1px solid hsl(var(--border));">
    <div class="overflow-x-auto">
        <table class="w-full" id="usersTable">
            <thead style="background: hsl(var(--secondary)); border-bottom: 1px solid hsl(var(--border));">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: hsl(var(--muted-foreground));">ID</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: hsl(var(--muted-foreground));">User</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: hsl(var(--muted-foreground));">Role</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: hsl(var(--muted-foreground));">Telegram ID</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: hsl(var(--muted-foreground));">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: hsl(var(--muted-foreground));">Joined</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider" style="color: hsl(var(--muted-foreground));">Last Active</th>
                    <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider" style="color: hsl(var(--muted-foreground));">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for role in ['admin', 'instructor', 'learner'] %}
                    {% if users_by_role[role]|length > 0 %}
                        <!-- Role Group Header -->
                        <tr class="group-header">
                            <td colspan="8" class="px-6 py-3" style="color: hsl(var(--foreground));">
                                <strong>{{ role|capitalize }}s</strong> <span style="color: hsl(var(--muted-foreground));">({{ users_by_role[role]|length }})</span>
                            </td>
                        </tr>
                        
                        <!-- Users in this role -->
                        {% for user in users_by_role[role] %}
                        <tr style="border-bottom: 1px solid hsl(var(--border));">
                            <td class="px-6 py-4 text-sm" style="color: hsl(var(--muted-foreground));">{{ user.id }}</td>
                            <td class="px-6 py-4">
                                <a href="{{ url_for('user_detail', user_id=user.id) }}" class="text-sm font-medium" style="color: hsl(var(--foreground));">
                                    {{ user.first_name }} {{ user.last_name or '' }}
                                </a>
                                <div class="text-xs" style="color: hsl(var(--muted-foreground));">@{{ user.username or 'N/A' }}</div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="role-badge role-{{ user.role or 'learner' }}">
                                    {{ (user.role or 'learner')|capitalize }}
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm font-mono" style="color: hsl(var(--muted-foreground));">{{ user.telegram_id }}</td>
                            <td class="px-6 py-4">
                                <span class="status-badge {% if user.is_active %}status-active{% else %}status-inactive{% endif %}">
                                    {% if user.is_active %}Active{% else %}Inactive{% endif %}
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm" style="color: hsl(var(--muted-foreground));">{{ user.created_at.strftime('%Y-%m-%d') }}</td>
                            <td class="px-6 py-4 text-sm" style="color: hsl(var(--muted-foreground));">{{ user.last_active.strftime('%Y-%m-%d %H:%M') if user.last_active else 'Never' }}</td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="{{ url_for('user_detail', user_id=user.id) }}" class="px-3 py-1.5 text-xs font-medium rounded transition-colors" style="color: hsl(var(--foreground)); background: hsl(var(--card)); border: 1px solid hsl(var(--border));">
                                        View
                                    </a>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    {% endif %}
                {% endfor %}
                
                {% if users|length == 0 %}
                <tr>
                    <td colspan="8" class="px-6 py-8 text-center text-sm" style="color: hsl(var(--muted-foreground));">
                        No users found.
                    </td>
                </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
</div>

<script>
function exportUsers() {
    const table = document.getElementById('usersTable');
    const rows = [];
    
    // Add header
    rows.push(['ID', 'Name', 'Username', 'Role', 'Telegram ID', 'Status', 'Joined', 'Last Active']);
    
    // Add data rows (skip group headers)
    const dataRows = table.querySelectorAll('tbody tr:not(.group-header)');
    dataRows.forEach(row => {
        const cols = row.querySelectorAll('td');
        if (cols.length >= 7) {
            const rowData = [
                cols[0].textContent.trim(),
                cols[1].querySelector('a')?.textContent.trim() || '',
                cols[1].querySelector('.text-xs')?.textContent.trim().replace('@', '') || '',
                cols[2].textContent.trim(),
                cols[3].textContent.trim(),
                cols[4].textContent.trim(),
                cols[5].textContent.trim(),
                cols[6].textContent.trim()
            ];
            rows.push(rowData);
        }
    });
    
    // Create CSV
    const csv = rows.map(row => row.map(cell => `"${cell}"`).join(',')).join('\n');
    
    // Download
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `users_export_${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
    window.URL.revokeObjectURL(url);
}
</script>
{% endblock %}
