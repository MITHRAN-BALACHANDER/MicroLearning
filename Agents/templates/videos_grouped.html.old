{% extends "base.html" %}
{% block title %}Videos - MicroLearning Admin{% endblock %}

{% block extra_css %}
<style>
    .group-header {
        background: hsl(var(--secondary));
        border-top: 2px solid hsl(var(--primary));
        font-weight: 600;
    }
    
    .category-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 0.375rem;
        text-transform: capitalize;
    }
    
    .category-onboarding {
        background: hsl(var(--primary));
        color: hsl(var(--primary-foreground));
    }
    
    .category-technical {
        background: hsl(var(--foreground));
        color: hsl(var(--background));
    }
    
    .category-business {
        background: hsl(0, 0%, 30%);
        color: hsl(var(--primary-foreground));
    }
    
    .category-general {
        background: hsl(var(--secondary));
        color: hsl(var(--foreground));
        border: 1px solid hsl(var(--border));
    }
    
    .status-badge {
        display: inline-flex;
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        font-weight: 500;
        border-radius: 0.25rem;
    }
    
    .status-active {
        background: hsl(var(--primary));
        color: hsl(var(--primary-foreground));
    }
    
    .status-inactive {
        background: hsl(var(--muted));
        color: hsl(var(--muted-foreground));
    }
</style>
{% endblock %}

{% block content %}
<div class="flex justify-between items-center mb-8">
    <div>
        <h1 class="text-3xl font-semibold tracking-tight" style="color: hsl(var(--foreground));">Videos</h1>
        <p class="mt-2 text-sm" style="color: hsl(var(--muted-foreground));">Manage learning content, grouped by category</p>
    </div>
    <div class="flex gap-3">
        <a href="{{ url_for('create_video') }}" class="px-4 py-2.5 text-sm font-semibold rounded-lg transition-colors inline-flex items-center" style="background: hsl(var(--primary)); color: hsl(var(--primary-foreground));">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"/></svg>
            Create Video
        </a>
        <a href="{{ url_for('add_video') }}" class="px-4 py-2.5 text-sm font-semibold rounded-lg transition-colors inline-flex items-center" style="background: hsl(var(--card)); color: hsl(var(--foreground)); border: 1px solid hsl(var(--border));">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Add Video
        </a>
    </div>
</div>

<div class="rounded-lg overflow-hidden" style="background: hsl(var(--card)); border: 1px solid hsl(var(--border));">
    <table class="min-w-full">
        <thead style="background: hsl(var(--secondary)); border-bottom: 1px solid hsl(var(--border));">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider" style="color: hsl(var(--muted-foreground));">Title</th>
                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider" style="color: hsl(var(--muted-foreground));">Category</th>
                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider" style="color: hsl(var(--muted-foreground));">Description</th>
                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider" style="color: hsl(var(--muted-foreground));">Status</th>
                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider" style="color: hsl(var(--muted-foreground));">Views</th>
                <th class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wider" style="color: hsl(var(--muted-foreground));">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for category in ['onboarding', 'technical', 'business', 'general'] %}
                {% if videos_by_category[category]|length > 0 %}
                    <!-- Category Group Header -->
                    <tr class="group-header">
                        <td colspan="6" class="px-6 py-3" style="color: hsl(var(--foreground));">
                            <strong>{{ category|capitalize }}</strong> <span style="color: hsl(var(--muted-foreground));">({{ videos_by_category[category]|length }})</span>
                        </td>
                    </tr>
                    
                    <!-- Videos in this category -->
                    {% for video in videos_by_category[category] %}
                    <tr style="border-bottom: 1px solid hsl(var(--border));">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium" style="color: hsl(var(--foreground));">{{ video.title }}</div>
                        </td>
                        <td class="px-6 py-4">
                            <span class="category-badge category-{{ video.category or 'general' }}">
                                {{ (video.category or 'general')|capitalize }}
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-sm max-w-xs truncate" style="color: hsl(var(--muted-foreground));">{{ video.description or 'No description' }}</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="status-badge {% if video.is_active %}status-active{% else %}status-inactive{% endif %}">
                                {{ 'Active' if video.is_active else 'Inactive' }}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm" style="color: hsl(var(--muted-foreground));">{{ video.view_count or 0 }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                            <a href="{{ url_for('edit_video', video_id=video.id) }}" class="px-3 py-1.5 text-xs font-medium rounded transition-colors" style="color: hsl(var(--foreground)); background: hsl(var(--card)); border: 1px solid hsl(var(--border));">Edit</a>
                            <a href="{{ url_for('toggle_video', video_id=video.id) }}" class="px-3 py-1.5 text-xs font-medium rounded transition-colors" style="color: hsl(var(--foreground)); background: hsl(var(--card)); border: 1px solid hsl(var(--border));">{{ 'Deactivate' if video.is_active else 'Activate' }}</a>
                            <a href="{{ url_for('delete_video', video_id=video.id) }}" onclick="return confirm('Delete this video?')" class="px-3 py-1.5 text-xs font-medium rounded transition-colors" style="color: hsl(var(--foreground)); background: hsl(var(--card)); border: 1px solid hsl(var(--border));">Delete</a>
                        </td>
                    </tr>
                    {% endfor %}
                {% endif %}
            {% endfor %}
            
            {% if videos|length == 0 %}
            <tr>
                <td colspan="6" class="px-6 py-8 text-center text-sm" style="color: hsl(var(--muted-foreground));">
                    No videos found. Click "Add Video" to get started.
                </td>
            </tr>
            {% endif %}
        </tbody>
    </table>
</div>
{% endblock %}
